{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "{apex,static}/**"
    },
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{apex,static}/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
