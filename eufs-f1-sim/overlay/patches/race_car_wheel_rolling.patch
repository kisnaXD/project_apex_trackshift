+void RaceCarModelPlugin::animateWheels(const double dt) {
+  if (!_animate_wheels || !std::isfinite(dt) || dt <= 0.0) return;
+  const double radius = _vehicle->getParam().tire.radius;
+  const double omega = radius > 0.0 ? _state.v_x / radius : 0.0;
+  _wheel_angle += omega * dt;
+  if (std::abs(_wheel_angle) > 2.0 * M_PI) {
+    _wheel_angle = std::fmod(_wheel_angle, 2.0 * M_PI);
+  }
+  for (const auto &joint : {_left_front_wheel_joint, _right_front_wheel_joint,
+                            _left_rear_wheel_joint, _right_rear_wheel_joint}) {
+    joint->SetPosition(0, _wheel_angle, true);
+    joint->SetVelocity(0, omega);
+  }
 }
 
