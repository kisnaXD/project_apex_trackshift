<?xml version="1.0"?>
<robot name="racecar" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:arg name="is_lidar_enable" default="true" />
<xacro:arg name="forgez_max_power_w" default="12000.0" />
<xacro:arg name="robot_namespace" default="eufs" />

<!-- Classic paints STL visuals from <material>NAME</material> looked up in
     gazebo.material (entrypoint appends EUFSF1/Silver and EUFSF1/TireBlack). -->

<gazebo reference="chassis">
  <mu1 value="0.0"/>
  <mu2 value="0.0"/>
  <kp  value="10000000.0" />
  <kd  value="1.0" />
  <material>EUFSF1/Silver</material>
  <visual>
    <material>
      <ambient>0.75 0.75 0.78 1</ambient>
      <diffuse>0.75 0.75 0.78 1</diffuse>
      <specular>0.90 0.90 0.95 1</specular>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>EUFSF1/Silver</name>
      </script>
    </material>
  </visual>
</gazebo>

<gazebo reference="front_wing">
  <material>EUFSF1/Silver</material>
  <visual>
    <material>
      <ambient>0.75 0.75 0.78 1</ambient>
      <diffuse>0.75 0.75 0.78 1</diffuse>
      <specular>0.90 0.90 0.95 1</specular>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>EUFSF1/Silver</name>
      </script>
    </material>
  </visual>
</gazebo>

<gazebo reference="rear_wing">
  <material>EUFSF1/Silver</material>
  <visual>
    <material>
      <ambient>0.75 0.75 0.78 1</ambient>
      <diffuse>0.75 0.75 0.78 1</diffuse>
      <specular>0.90 0.90 0.95 1</specular>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>EUFSF1/Silver</name>
      </script>
    </material>
  </visual>
</gazebo>

<gazebo reference="left_rear_wheel">
  <mu1 value="0.8"/>
  <mu2 value="0.8"/>
  <kp  value="500000.0" />
  <kd  value="50.0" />
  <minDepth>0.001</minDepth>
  <maxVel>1.0</maxVel>
  <material>EUFSF1/TireBlack</material>
  <visual>
    <material>
      <ambient>0.05 0.05 0.05 1</ambient>
      <diffuse>0.05 0.05 0.05 1</diffuse>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>EUFSF1/TireBlack</name>
      </script>
    </material>
  </visual>
</gazebo>

<gazebo reference="right_rear_wheel">
  <mu1 value="0.8"/>
  <mu2 value="0.8"/>
  <kp  value="500000.0" />
  <kd  value="50.0" />
  <minDepth>0.001</minDepth>
  <maxVel>1.0</maxVel>
  <material>EUFSF1/TireBlack</material>
  <visual>
    <material>
      <ambient>0.05 0.05 0.05 1</ambient>
      <diffuse>0.05 0.05 0.05 1</diffuse>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>EUFSF1/TireBlack</name>
      </script>
    </material>
  </visual>
</gazebo>

<gazebo reference="left_front_wheel">
  <mu1 value="0.8"/>
  <mu2 value="0.8"/>
  <kp  value="500000.0" />
  <kd  value="50.0" />
  <minDepth>0.001</minDepth>
  <maxVel>1.0</maxVel>
  <material>EUFSF1/TireBlack</material>
  <visual>
    <material>
      <ambient>0.05 0.05 0.05 1</ambient>
      <diffuse>0.05 0.05 0.05 1</diffuse>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>EUFSF1/TireBlack</name>
      </script>
    </material>
  </visual>
</gazebo>

<gazebo reference="right_front_wheel">
  <mu1 value="0.8"/>
  <mu2 value="0.8"/>
  <kp  value="500000.0" />
  <kd  value="50.0" />
  <minDepth>0.001</minDepth>
  <maxVel>1.0</maxVel>
  <material>EUFSF1/TireBlack</material>
  <visual>
    <material>
      <ambient>0.05 0.05 0.05 1</ambient>
      <diffuse>0.05 0.05 0.05 1</diffuse>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>EUFSF1/TireBlack</name>
      </script>
    </material>
  </visual>
</gazebo>

<!-- Gazebo plugins -->

<gazebo>
  <plugin name="gazebo_ros_energy_aware_ackermann_gate" filename="libgazebo_ros_energy_aware_ackermann_gate.so">
    <ros>
      <namespace>$(arg robot_namespace)</namespace>
      <remapping>input_cmd_vel:=cmd_vel</remapping>
      <remapping>output_cmd_vel:=energy_cmd_vel</remapping>
      <remapping>battery_state:=forgez/battery_state</remapping>
      <remapping>gate_derate_reason:=forgez/gate_derate_reason</remapping>
    </ros>
    <update_rate>50.0</update_rate>
    <link_name>base_link</link_name>
    <vehicle_mass_kg>788.0</vehicle_mass_kg>
    <max_deploy_power_w>$(arg forgez_max_power_w)</max_deploy_power_w>
    <reserve_energy_wh>20.0</reserve_energy_wh>
    <reserve_buffer_wh>60.0</reserve_buffer_wh>
    <thermal_derate_temperature>90.0</thermal_derate_temperature>
    <shutdown_temperature>105.0</shutdown_temperature>
    <max_launch_accel_mps2>8.0</max_launch_accel_mps2>
    <max_brake_accel_mps2>12.0</max_brake_accel_mps2>
    <drag_coefficient_area>1.35</drag_coefficient_area>
    <air_density>1.225</air_density>
    <rolling_resistance_coefficient>0.015</rolling_resistance_coefficient>
    <max_speed_mps>80.0</max_speed_mps>
  </plugin>

  <plugin name="gazebo_ros_ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">

    <ros>
      <namespace>$(arg robot_namespace)</namespace>
      <remapping>cmd_vel:=cmd_vel</remapping>
      <remapping>odom:=odom</remapping>
      <remapping>distance:=distance</remapping>
    </ros>

    <update_rate>100.0</update_rate>

    <!-- wheels -->
    <front_left_joint>left_front_wheel_joint</front_left_joint>
    <front_right_joint>right_front_wheel_joint</front_right_joint>
    <rear_left_joint>left_rear_wheel_joint</rear_left_joint>
    <rear_right_joint>right_rear_wheel_joint</rear_right_joint>
    <left_steering_joint>left_steering_hinge_joint</left_steering_joint>
    <right_steering_joint>right_steering_hinge_joint</right_steering_joint>

    <!-- Max absolute steer angle for tyre in radians-->
    <!-- Any cmd_vel angular z greater than this would be capped -->
    <max_steer>0.6458</max_steer>

    <!-- Max absolute steering angle of steering wheel -->
    <max_steering_angle>7.85</max_steering_angle>

    <!-- Max absolute linear speed in m/s -->
    <max_speed>80</max_speed>

    <!-- PID tuning -->
    <left_steering_pid_gain>12.0 0.0 2.0</left_steering_pid_gain>
    <left_steering_i_range>0 0</left_steering_i_range>
    <right_steering_pid_gain>12.0 0.0 2.0</right_steering_pid_gain>
    <right_steering_i_range>0 0</right_steering_i_range>
    <linear_velocity_pid_gain>30.0 0.0 0.0</linear_velocity_pid_gain>
    <linear_velocity_i_range>0 0</linear_velocity_i_range>

    <!-- output -->
    <publish_odom>true</publish_odom>
    <publish_odom_tf>false</publish_odom_tf>
    <publish_wheel_tf>false</publish_wheel_tf>
    <publish_distance>true</publish_distance>

    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>

  </plugin>

  <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
    <ros>
      <namespace>$(arg robot_namespace)</namespace>
    </ros>
    <update_rate>50</update_rate>
    <joint_name>left_rear_wheel_joint</joint_name>
    <joint_name>right_rear_wheel_joint</joint_name>
    <joint_name>left_front_wheel_joint</joint_name>
    <joint_name>right_front_wheel_joint</joint_name>
    <joint_name>left_steering_hinge_joint</joint_name>
    <joint_name>right_steering_hinge_joint</joint_name>
  </plugin>
</gazebo>

</robot>
